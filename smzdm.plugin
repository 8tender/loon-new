#!name = 什么值得买签到(App)
#!desc = 捕获App签到请求并每日重放
#!author = 你的用户名

[Script]
http-request ^https:\/\/user-api\.smzdm\.com\/checkin$ script-path=https://raw.githubusercontent.com/8tender/loon-new/refs/heads/main/smzdm.js, requires-body=true, timeout=10, tag=什么值得买捕获
cron "10 0 * * *" script-path=https://raw.githubusercontent.com/8tender/loon-new/refs/heads/main/smzdm.js, timeout=30, tag=什么值得买签到

[MITM]
hostname = user-api.smzdm.com
